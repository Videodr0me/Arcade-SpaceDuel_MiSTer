# Atari Space Duel core file list.
# Add production sources here rather than through the Quartus IDE.

# CPU and machine
set_global_assignment -name VHDL_FILE rtl/t65/T65_Pack.vhd
set_global_assignment -name VHDL_FILE rtl/t65/T65_MCode.vhd
set_global_assignment -name VHDL_FILE rtl/t65/T65_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/t65/T65.vhd
set_global_assignment -name VHDL_FILE rtl/dpram.vhd
set_global_assignment -name VHDL_FILE rtl/ram2k.vhd
set_global_assignment -name VHDL_FILE rtl/vecrom.vhd
set_global_assignment -name VHDL_FILE rtl/avg/vector_drawer.vhd
set_global_assignment -name VHDL_FILE rtl/avg/avg_prom_core.vhd
set_global_assignment -name VHDL_FILE rtl/avg/avg.vhd
set_global_assignment -name VHDL_FILE rtl/pokey.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/atari_er2055.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_audio_filter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_core.sv

# Video
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_control_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_status_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_profile_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_geometry.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_beam_energy.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video_fractional_ce.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spaceduel_video.sv
set_global_assignment -name VERILOG_FILE rtl/pause.v

# Vector framebuffer and CRT effects
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_layout_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_spill_bloom_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_spill_source.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_rasterizer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_phosphor_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_phosphor_compositor.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_ddr_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_buffer_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_tile_cache_manager.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_readout.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_blur.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_filter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_rle_encoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_rle_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_sync_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_sdram_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_sdram_delay.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_halo_bspline.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_halo_wide.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_wg6100_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_final_present.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/videodr0me_fb/vfb_halo_pipeline.sv
