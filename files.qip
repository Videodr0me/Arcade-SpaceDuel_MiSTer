# PLL and top level
set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name SDC_FILE Arcade-SpaceDuel.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-SpaceDuel.sv
